{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DanWahlin/agent-buddy/main/docs/schemas/plugin-manifest-v1.json",
  "title": "Agent Buddy plugin manifest (agent-buddy.plugin.json)",
  "description": "The companion checks the same rules in daemon/src/plugin-manifest.ts, which is authoritative.",
  "type": "object",
  "required": ["manifestVersion", "id", "name", "version", "description", "api", "runtime", "main"],
  "additionalProperties": true,
  "properties": {
    "$schema": {"type": "string"},
    "manifestVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 300},
    "publisher": {"type": "string", "maxLength": 60},
    "homepage": {"type": "string", "pattern": "^https://"},
    "license": {"type": "string", "maxLength": 40},
    "api": {"type": "string", "pattern": "^\\d{1,3}\\.\\d{1,3}$"},
    "runtime": {"const": "node"},
    "main": {"type": "string", "minLength": 1, "maxLength": 200, "not": {"pattern": "(^/|^[A-Za-z]:|(^|[\\\\/])\\.\\.([\\\\/]|$))"}},
    "permissions": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["speech.provide", "events.state", "events.agent", "voice.narrate", "status.read", "process.spawn"]}
    },
    "network": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:\\*\\.)?[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"}
    },
    "contributes": {
      "type": "object",
      "properties": {
        "speechProviders": {
          "type": "array", "maxItems": 4,
          "items": {
            "type": "object", "required": ["id", "name"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"},
              "name": {"type": "string", "minLength": 1, "maxLength": 40},
              "description": {"type": "string", "maxLength": 200}
            }
          }
        },
        "settings": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "required": ["key", "type", "title"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,31}$"},
              "type": {"enum": ["string", "secret", "select", "boolean", "number"]},
              "title": {"type": "string", "minLength": 1, "maxLength": 60},
              "description": {"type": "string", "maxLength": 300},
              "required": {"type": "boolean"},
              "default": {"type": ["string", "number", "boolean"]},
              "pattern": {"type": "string", "maxLength": 200},
              "min": {"type": "number"},
              "max": {"type": "number"},
              "options": {
                "type": "array", "minItems": 1, "maxItems": 50,
                "items": {
                  "type": "object", "required": ["value", "label"],
                  "properties": {"value": {"type": "string", "maxLength": 80}, "label": {"type": "string", "maxLength": 60}}
                }
              },
              "help": {
                "type": "object", "required": ["text", "url"],
                "properties": {"text": {"type": "string", "maxLength": 80}, "url": {"type": "string", "pattern": "^https://"}}
              }
            },
            "allOf": [
              {"if": {"properties": {"type": {"const": "secret"}}}, "then": {"not": {"required": ["default"]}}},
              {"if": {"properties": {"type": {"const": "select"}}}, "then": {"required": ["options"]}}
            ]
          }
        }
      }
    }
  }
}
